{
  "name": "@french-tech-homies/design-system",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Material Design 3 component kit on React Aria Components + Tailwind v4, distributed as a shadcn registry (copy-in source, no npm package) with a DESIGN.md at its centre.",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "theme:generate": "tsx tokens/generate-theme.mjs DESIGN.md",
    "theme:check": "tsx --test tokens/design-md.check.mjs",
    "design:lint": "designmd lint DESIGN.md && designmd lint tokens/DESIGN.resolved.md",
    "theme:resolve": "node tokens/resolve-theme.mjs",
    "md3": "node skills/ds-spec/md3.mjs",
    "registry:build": "node scripts/build-registry.mjs && shadcn build registry.json --output r",
    "test-storybook": "vitest run",
    "test-storybook:watch": "vitest",
    "registry:check-version": "node scripts/check-registry-version.mjs r",
    "registry:check-install": "node --test scripts/check-install.check.mjs scripts/check-components.check.mjs scripts/changed.check.mjs scripts/decide-publish.check.mjs",
    "registry:publishes": "node scripts/decide-publish.mjs"
  },
  "peerDependencies": {
    "next": "^16.2.7",
    "react": "^19.2.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-router": "^7.9.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-phone-number-input": "^3.4.9",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^1.0.0"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@material/material-color-utilities": "0.4.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.19.20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "playwright": "^1.60.0",
    "postcss": "^8.5.10",
    "react": "^19.2.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-router": "^7.18.2",
    "shadcn": "^4.19.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
