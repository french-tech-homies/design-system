  "shape": {
    "extra-small": 4,
    "small": 8,
    "medium": 12,
    "large": 16,
    "large-increased": 20,
    "extra-large": 28,
    "full": 9999
  },
  "elevation": {
    "1": "0 1px 2px 0 shadow@30%, 0 1px 3px 1px shadow@15%",
    "2": "0 1px 2px 0 shadow@30%, 0 2px 6px 2px shadow@15%",
    "3": "0 1px 3px 0 shadow@30%, 0 4px 8px 3px shadow@15%",
    "4": "0 2px 3px 0 shadow@30%, 0 6px 10px 4px shadow@15%",
    "5": "0 4px 4px 0 shadow@30%, 0 8px 12px 6px shadow@15%"
  },
  "motion": {
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "standard-accelerate": "cubic-bezier(0.3, 0, 1, 1)",
      "standard-decelerate": "cubic-bezier(0, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized-accelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "emphasized-decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)"
    },
    "duration": {
      "short-1": 50,
      "short-2": 100,
      "short-3": 150,
      "short-4": 200,
      "medium-1": 250,
      "medium-2": 300,
      "medium-3": 350,
      "medium-4": 400,
      "long-1": 450,
      "long-2": 500,
      "long-3": 550,
      "long-4": 600
    }
  },
  "state": {
    "layerOpacity": {
      "hover": 0.08,
      "focus": 0.1,
      "press": 0.1,
      "drag": 0.16
    },
    "disabledContentOpacity": 0.38,
    "disabledContainerOpacity": 0.12,
    "focusRing": {
      "width": 3,
      "offset": 2,
      "colorRole": "secondary"
    }
  }
}
